<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#F3F7F4">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_preview_title" android:textColor="#176B52" android:textStyle="bold" android:textSize="15sp" />
    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:text="@string/widget_preview_hint" android:textColor="#172D26" android:textSize="13sp" android:gravity="center_vertical" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/creator_credit" android:textColor="#172D26" android:textSize="11sp" />
</LinearLayout>
